server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html index.htm;

    # Sirviendo el Frontend de React estático
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse Proxy hacia el Backend de Ventas
    location /api/v1/ventas/ {
        # proxy_pass a la IP inyectada como variable de entorno
        proxy_pass http://${VENTAS_IP}:8080/api/v1/ventas/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Reverse Proxy hacia el Backend de Despachos
    location /api/v1/despachos/ {
        # proxy_pass a la IP inyectada como variable de entorno
        proxy_pass http://${DESPACHOS_IP}:8081/api/v1/despachos/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
